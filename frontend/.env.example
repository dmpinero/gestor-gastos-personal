# Opcional: por defecto el cliente API usa la ruta relativa "/api/v1", que en
# desarrollo reenvía el proxy de Vite (ver vite.config.ts) y en producción el
# de Nginx (ver nginx.conf). Solo hace falta definir esto para apuntar a una
# API en otro origen.
# VITE_URL_BASE_API=http://localhost:8000/api/v1
